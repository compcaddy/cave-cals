# Server only. Never use NEXT_PUBLIC_ for these credentials.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
OPENAI_API_KEY=
OPENAI_IDENTIFICATION_MODEL=gpt-6-astra
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
AI_DAILY_LIMIT=30
AI_MONTHLY_LIMIT=300
AI_GLOBAL_DAILY_LIMIT=1000
# Production: private Vercel Blob store, connected to this project.
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
# Apple App Store Connect > Users and Access > Integrations > In-App Purchase key.
APPLE_BUNDLE_ID=com.philstarkovich.cavecals
APPLE_TEAM_ID=J877QX85N5
APPLE_APP_ID=6809208501
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY=
APPLE_PRODUCT_IDS=com.philstarkovich.cavecals.ai.monthly,com.philstarkovich.cavecals.ai.yearly
APPLE_ENVIRONMENT=Production
# Verify Apple-signed sandbox subscriptions for TestFlight and App Review. Still requires App Attest.
APPLE_ALLOW_SANDBOX=true
# Local only: generate a random token >=32 characters. Never deploy these two values.
DEV_API_TOKEN=
LOCAL_UPLOADS=true
# Optional public App Store listing link (leave empty before release).
APP_STORE_URL=
