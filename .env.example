# Server only. Never use NEXT_PUBLIC_ for these credentials.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
OPENAI_API_KEY=
OPENAI_IDENTIFICATION_MODEL=gpt-6-astra
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
AI_DAILY_LIMIT=30
AI_MONTHLY_LIMIT=300
AI_GLOBAL_DAILY_LIMIT=1000
# Free signed manual macro estimates; also consume the AI budgets above, not the scan allowance.
MACRO_ESTIMATE_DAILY_LIMIT=10
# Production: private Vercel Blob store, connected to this project.
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
# Password for /admin (stats and errors); any user name. Without it /admin is a 404.
# Ten wrong passwords from one IP lock it out for an hour.
ADMIN_PASSWORD=
# Apple App Store Connect > Users and Access > Integrations > In-App Purchase key.
APPLE_BUNDLE_ID=com.philstarkovich.cavecals
APPLE_TEAM_ID=J877QX85N5
APPLE_APP_ID=6809208501
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY=
APPLE_PRODUCT_IDS=com.philstarkovich.cavecals.ai.monthly,com.philstarkovich.cavecals.ai.yearly
APPLE_ENVIRONMENT=Production
# Verify Apple-signed sandbox subscriptions for TestFlight and App Review. Still requires App Attest.
APPLE_ALLOW_SANDBOX=true
# Local only: generate a random token >=32 characters. Never deploy these two values.
DEV_API_TOKEN=
LOCAL_UPLOADS=true
# Optional public App Store listing link (leave empty before release).
APP_STORE_URL=

# Server-only food search. Basic is supported immediately; use premier after approval.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
FATSECRET_API_TIER=basic
FOOD_SEARCH_DAILY_LIMIT=4500

# Optional static outbound proxy for FatSecret only; set from the Fixie integration.
FIXIE_URL=

# Clans (Documentation/Clans.md).
# Google sign-in: the iOS OAuth client ID(s), comma-separated. Tokens made for any other client are refused.
GOOGLE_CLIENT_IDS=
# Optional additional web OAuth audience for Android; preserves the existing iOS list.
GOOGLE_ANDROID_CLIENT_ID=
# Sign in with Apple key (Certificates, Identifiers & Profiles > Keys), used to revoke Apple sign-in when a clan account is deleted.
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts the stored Apple refresh tokens.
CLAN_TOKEN_KEY=
# APNs auth key (.p8) for clan push notifications. APNS_TEAM_ID defaults to APPLE_TEAM_ID.
APNS_KEY_ID=
APNS_KEY=
# News email (Amazon SES SMTP) from /admin/email, only to people who opted in.
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=
# A verified SES identity, e.g. Cave Cals <hello@cavecals.com>
EMAIL_FROM=
# Required in every news email (CAN-SPAM): the business's postal address.
EMAIL_POSTAL_ADDRESS=

# Android server-side subscriber lookup: use the Play app public goog_ SDK key.
# The backend still verifies store, product, expiry, refund and sandbox status.
REVENUECAT_ANDROID_API_KEY=
