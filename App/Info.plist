<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>NSCameraUsageDescription</key>
	<string>Take food photos for calorie estimates and scan food barcodes.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIAppFonts</key>
	<array>
		<string>Fonts/CaveCount-Regular.otf</string>
		<string>Fonts/Schoolbell-Regular.ttf</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record a food description to estimate calories when you choose voice logging.</string>
	<key>AIBackendURL</key>
	<string>$(AI_BACKEND_URL)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.philstarkovich.cavecals.logging</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cavecals</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.philstarkovich.cavecals.log.voice</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Voice Log</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>mic</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.philstarkovich.cavecals.log.image</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Meal Scan</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>photo</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.philstarkovich.cavecals.log.barcode</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Barcode Scan</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>barcode.viewfinder</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.philstarkovich.cavecals.log.add</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Search/Add</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>plus</string>
		</dict>
	</array>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Share weigh-ins you record in Cave Cals with Apple Health so your connected apps can use them.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Cave Cals uses Apple Health to keep the weigh-ins you choose to share up to date. Cave Cals does not read your Health history.</string>
</dict>
</plist>
